{
  "name": "casehub-blocks-ui",
  "version": "0.0.0",
  "description": "Shared UI components for CaseHub applications — composed from casehub-pages primitives",
  "repository": "https://github.com/casehubio/blocks-ui",
  "author": "Mark Proctor",
  "license": "Apache-2.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "components/*"
  ],
  "packageManager": "yarn@4.10.3",
  "resolutions": {
    "@casehubio/pages-component": "portal:./.casehub-packages/packages/pages-component",
    "@casehubio/pages-data": "portal:./.casehub-packages/packages/pages-data",
    "@casehubio/pages-primitives": "portal:./.casehub-packages/packages/pages-primitives",
    "@casehubio/pages-table": "portal:./.casehub-packages/packages/pages-table",
    "@casehubio/pages-ui-components": "portal:./.casehub-packages/packages/pages-ui-components",
    "@casehubio/pages-ui-tokens": "portal:./.casehub-packages/packages/pages-ui-tokens",
    "@casehubio/pages-viz": "portal:./.casehub-packages/packages/pages-viz",
    "@casehubio/graph-core": "portal:./.casehub-packages/packages/graph-core"
  },
  "scripts": {
    "build": "yarn workspaces foreach -A --topological run build",
    "typecheck": "tsc --build",
    "test": "yarn workspaces foreach -A run test",
    "clean": "yarn workspaces foreach -A run clean",
    "examples": "yarn --cwd examples dev"
  }
}
